# BELL — server/env template (never commit real values)

# Supabase / Lovable Cloud
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Session (httpOnly cookie HMAC — min 16 chars)
BELL_SESSION_SECRET=

# AgentRouter (no OpenAI required)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_ANTHROPIC_BASE=https://agentrouter.org
AGENTROUTER_USE_TOR=0
AGENTROUTER_TOR_SOCKS=socks5h://127.0.0.1:9050
BELL_LLM_MODEL=deepseek-v4-flash
BELL_LLM_RELAY_URL=
BELL_LLM_RELAY_KEY=

# Optional Lovable AI gateway (fail-closed if neither this nor AgentRouter)
LOVABLE_API_KEY=

# Research
TAVILY_API_KEY=
TINYFISH_API_KEY=

# Binance Web3 (signed Trading / Transaction)
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Optional
VENICE_API_KEY=
