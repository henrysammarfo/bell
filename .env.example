# BELL — server/env template (never commit real values)

# Neon (Vercel Marketplace → Bell project)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
NEON_AUTH_BASE_URL=
VITE_NEON_AUTH_URL=
NEON_AUTH_COOKIE_SECRET=

# Session (httpOnly cookie HMAC — min 16 chars)
BELL_SESSION_SECRET=

# AgentRouter (Aliyun WAF on cloud IPs — use Tor locally or Vercel AI Gateway in prod)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_ANTHROPIC_BASE=https://agentrouter.org
AGENTROUTER_USE_TOR=0
AGENTROUTER_TOR_SOCKS=socks5h://127.0.0.1:9050
BELL_LLM_MODEL=deepseek-v4-flash
BELL_LLM_RELAY_URL=
BELL_LLM_RELAY_KEY=
# Novel WAF bypass on Vercel: AI Gateway via OIDC (auto on Vercel) or AI_GATEWAY_API_KEY
AI_GATEWAY_API_KEY=
BELL_AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# Optional Lovable AI gateway
LOVABLE_API_KEY=

# Research
TAVILY_API_KEY=
TINYFISH_API_KEY=

# Binance Web3 (signed Trading / Transaction) — still required for real simulate/broadcast
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# TypeSafe Jev via OpenRouter Decisions API (gift wrap second opinion — not an LLM)
OPENROUTER_API_KEY=
# BELL_JEV_API_KEY=   # optional alias
BELL_JEV_MODEL=typesafe/jev-1.13

# Optional
VENICE_API_KEY=

# Legacy Supabase (optional during cutover — not used when Neon Auth is live)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
